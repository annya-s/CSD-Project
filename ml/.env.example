# Example only. Set these in your server process environment; this file is not auto-loaded.
ML_ARTIFACT_DIR=ml/artifacts/wheat_biomass_v1
ML_PREDICTION_DIR=ml/predictions
# Optional for loopback development; required to bind the API beyond loopback.
ML_API_TOKEN=
# Database reads and prediction uploads are independently opt-in; both default off.
SUPABASE_READ_ENABLED=false
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy JWT alternative only; never expose either secret in a browser.
SUPABASE_SERVICE_ROLE_KEY=
